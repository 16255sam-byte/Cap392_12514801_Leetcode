class LFUCache {

    class Node {
        int value;
        int freq;

        Node(int value) {
            this.value = value;
            this.freq = 1;
        }
    }

    int capacity;
    int minFreq;

    HashMap<Integer, Node> keyMap;
    HashMap<Integer, LinkedHashSet<Integer>> freqMap;

    public LFUCache(int capacity) {

        this.capacity = capacity;
        this.minFreq = 0;

        keyMap = new HashMap<>();
        freqMap = new HashMap<>();
    }

    public int get(int key) {

        if (!keyMap.containsKey(key)) {
            return -1;
        }

        Node node = keyMap.get(key);

        int oldFreq = node.freq;

        freqMap.get(oldFreq).remove(key);

        if (oldFreq == minFreq &&
            freqMap.get(oldFreq).isEmpty()) {

            minFreq++;
        }

        node.freq++;

        freqMap.putIfAbsent(node.freq, new LinkedHashSet<>());

        freqMap.get(node.freq).add(key);

        return node.value;
    }

    public void put(int key, int value) {

        if (capacity == 0) {
            return;
        }

        if (keyMap.containsKey(key)) {

            Node node = keyMap.get(key);

            node.value = value;

            get(key);

            return;
        }

        if (keyMap.size() == capacity) {

            int evictKey = freqMap.get(minFreq)
                                  .iterator()
                                  .next();

            freqMap.get(minFreq).remove(evictKey);

            keyMap.remove(evictKey);
        }

        Node newNode = new Node(value);

        keyMap.put(key, newNode);

        freqMap.putIfAbsent(1, new LinkedHashSet<>());

        freqMap.get(1).add(key);

        minFreq = 1;
    }
}
